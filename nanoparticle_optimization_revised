%% ========================================================================
% LOCAL FUNCTIONS
% Each function below isolates one scientific or computational operation.
% Keeping these operations separate improves reproducibility and makes future
% replacement of transport or release assumptions straightforward.
%% ========================================================================

function create_targeting_surface_figure(pH_grid, ros_grid_mM, ...
    metric_grid, scenarios, metric_short_name, metric_long_name, ...
    figure_title, output_base, resolution_dpi)
% CREATE_TARGETING_SURFACE_FIGURE Generate paired 3D and contour views.
%
% The ROS axis is logarithmic because the landscape spans two orders of
% magnitude. Scenario markers are interpolated in log10(ROS) space, matching
% the map sampling. The maximum marker is descriptive only and must not be
% interpreted as a clinical optimum.

    % Extract the four exploratory cap conditions used elsewhere in the model.
    scenario_pH = [scenarios.cap_pH];
    scenario_ros_mM = [scenarios.cap_ROS_mM];

    % Interpolate marker heights in logarithmic ROS coordinates so the
    % interpolation geometry matches the log-spaced surface grid.
    scenario_metric = interp2(pH_grid, log10(ros_grid_mM), metric_grid, ...
        scenario_pH, log10(scenario_ros_mM), 'linear');

    % Locate the highest sampled value for descriptive annotation.
    [maximum_metric, maximum_linear_index] = max(metric_grid(:));
    [maximum_row, maximum_column] = ind2sub(size(metric_grid), ...
        maximum_linear_index);
    maximum_pH = pH_grid(maximum_row, maximum_column);
    maximum_ros_mM = ros_grid_mM(maximum_row, maximum_column);

    % Lift markers slightly above the surface so they remain visible.
    metric_span = max(metric_grid(:)) - min(metric_grid(:));
    marker_offset = max(0.015 * metric_span, 1e-6);

    figure('Color','w','Position',[70 70 1250 540]);
    surface_layout = tiledlayout(1,2, ...
        'TileSpacing','compact','Padding','compact');

    % Panel A: oblique three-dimensional response surface.
    surface_axes = nexttile(surface_layout);
    surf(surface_axes, pH_grid, ros_grid_mM, metric_grid, ...
        'EdgeColor','none','FaceAlpha',1.0);
    hold(surface_axes,'on');
    plot3(surface_axes, scenario_pH, scenario_ros_mM, ...
        scenario_metric + marker_offset, 'ko', 'MarkerSize',6.5, ...
        'MarkerFaceColor','w','LineWidth',1.2);
    plot3(surface_axes, maximum_pH, maximum_ros_mM, ...
        maximum_metric + marker_offset, 'kp', 'MarkerSize',13, ...
        'MarkerFaceColor','w','LineWidth',1.4);

    % Label scenarios numerically to avoid a long, obstructive legend.
    for scenario_index = 1:numel(scenarios)
        text(surface_axes, scenario_pH(scenario_index), ...
            scenario_ros_mM(scenario_index), ...
            scenario_metric(scenario_index) + 2.2*marker_offset, ...
            sprintf('S%d',scenario_index), ...
            'FontSize',9,'FontWeight','bold', ...
            'HorizontalAlignment','center');
    end

    set(surface_axes,'YScale','log','XDir','reverse');
    view(surface_axes,-48,30);
    axis(surface_axes,'tight');
    grid(surface_axes,'on');
    box(surface_axes,'on');
    xlabel(surface_axes,'Plaque-cap pH');
    ylabel(surface_axes,'Plaque-cap ROS (mM)');
    zlabel(surface_axes,metric_short_name);
    title(surface_axes,sprintf('3D %s surface',metric_short_name));
    colormap(surface_axes,parula(256));
    surface_colorbar = colorbar(surface_axes);
    surface_colorbar.Label.String = metric_short_name;

    % Panel B: top-down contour map for more precise regional interpretation.
    contour_axes = nexttile(surface_layout);
    contourf(contour_axes, pH_grid, ros_grid_mM, metric_grid, ...
        18,'LineColor','none');
    hold(contour_axes,'on');
    scatter(contour_axes, scenario_pH, scenario_ros_mM, 52, 'o', ...
        'filled','MarkerEdgeColor','k');
    plot(contour_axes, maximum_pH, maximum_ros_mM, 'kp', ...
        'MarkerSize',13,'MarkerFaceColor','w','LineWidth',1.4);

    for scenario_index = 1:numel(scenarios)
        text(contour_axes, scenario_pH(scenario_index), ...
            scenario_ros_mM(scenario_index), ...
            sprintf('  S%d',scenario_index), ...
            'FontSize',9,'FontWeight','bold', ...
            'VerticalAlignment','middle');
    end

    set(contour_axes,'YScale','log','XDir','reverse');
    grid(contour_axes,'on');
    box(contour_axes,'on');
    xlabel(contour_axes,'Plaque-cap pH');
    ylabel(contour_axes,'Plaque-cap ROS (mM)');
    title(contour_axes,sprintf('Top-down %s contour',metric_short_name));
    colormap(contour_axes,parula(256));
    contour_colorbar = colorbar(contour_axes);
    contour_colorbar.Label.String = metric_short_name;

    title(surface_layout, sprintf('%s (transport held constant)', ...
        figure_title));

    % Add a concise interpretation note without implying clinical optimality.
    annotation(gcf,'textbox',[0.12 0.005 0.76 0.045], ...
        'String',sprintf(['Surface height represents %s. The star marks the ' ...
        'highest sampled grid value, not a clinical optimum.'], ...
        metric_long_name), ...
        'EdgeColor','none','HorizontalAlignment','center', ...
        'FontSize',9);

    export_publication_figure(gcf, output_base, resolution_dpi);
end

function export_publication_figure(fig_handle, output_base, resolution_dpi)
% EXPORT_PUBLICATION_FIGURE Save one plot in three publication-ready formats.
% PNG: high-resolution raster image for Word, posters, and online submission.
% PDF: vector artwork that remains sharp when enlarged.
% FIG: editable MATLAB figure for later label, legend, or layout changes.

    % Use a consistent manuscript-width canvas.
    set(fig_handle, 'Units', 'inches', 'Position', [1 1 7.2 4.8], ...
        'PaperPositionMode', 'auto', 'Color', 'white');

    % Standardize axes, labels, and plotted objects without changing data.
    axes_handles = findall(fig_handle, 'Type', 'axes');
    for axis_index = 1:numel(axes_handles)
        set(axes_handles(axis_index), 'FontName', 'Arial', 'FontSize', 11, ...
            'LineWidth', 1.0, 'Box', 'off', 'TickDir', 'out');
    end

    line_handles = findall(fig_handle, 'Type', 'line');
    for line_index = 1:numel(line_handles)
        if get(line_handles(line_index), 'LineWidth') < 1.5
            set(line_handles(line_index), 'LineWidth', 1.5);
        end
    end

    % Write a 600-DPI PNG for documents and posters.
    exportgraphics(fig_handle, [output_base '.png'], ...
        'Resolution', resolution_dpi, 'BackgroundColor', 'white');

    % Write a true vector PDF for journals and lossless resizing.
    exportgraphics(fig_handle, [output_base '.pdf'], ...
        'ContentType', 'vector', 'BackgroundColor', 'white');

    % Preserve an editable MATLAB copy.
    savefig(fig_handle, [output_base '.fig']);
end

function parameters = unconstrained_to_bounded(theta, lower, upper)
% Map unconstrained fminsearch variables to finite physical bounds.
    parameters = lower + (upper-lower) ./ (1 + exp(-theta));
end

function theta = bounded_to_unconstrained(parameters, lower, upper)
% Invert the logistic map so a physically meaningful initial guess can be used.
    scaled = (parameters-lower) ./ (upper-lower);
    scaled = min(max(scaled,1e-10),1-1e-10);
    theta = log(scaled ./ (1-scaled));
end

function sse = ros_benchmark_sse(theta, benchmark, training_indices, lower, upper)
% Calculate training squared error for the reduced ROS release benchmark.
    parameters = unconstrained_to_bounded(theta, lower, upper);
    errors = [];
    for idx = training_indices
        prediction = ros_benchmark_model(parameters, benchmark.time_h, benchmark.ros_mM(idx));
        observed = benchmark.release_fraction(idx,:)';
        errors = [errors; prediction-observed]; %#ok<AGROW>
    end
    sse = sum(errors.^2);
end

function release = ros_benchmark_model(parameters, time_h, ros_mM)
% Predict in-vitro release using concentration-dependent rate and plateau terms.
    k0 = parameters(1);
    kmax = parameters(2);
    K = parameters(3);
    hill_rate = parameters(4);
    F0 = parameters(5);
    amplitude = parameters(6);
    K_plateau = parameters(7);
    hill_plateau = parameters(8);

    rate = k0 + kmax * ros_mM^hill_rate / ...
        (K^hill_rate + ros_mM^hill_rate + eps);
    plateau = F0 + amplitude * ros_mM^hill_plateau / ...
        (K_plateau^hill_plateau + ros_mM^hill_plateau + eps);
    release = plateau .* (1-exp(-rate.*time_h));
end


function sse = plateau_release_sse(theta,time_h,observed,lower,upper)
% Calculate squared error for a bounded plateau-times-first-order model.
    parameters = unconstrained_to_bounded(theta,lower,upper);
    prediction = plateau_release_model(parameters,time_h);
    sse = sum((prediction-observed).^2);
end

function release = plateau_release_model(parameters,time_h)
% Calculate release = plateau * (1-exp(-k*time)).
    plateau = parameters(1);
    rate = parameters(2);
    release = plateau .* (1-exp(-rate.*time_h));
end

function transport = default_transport_parameters()
% Return the transparent reference set of systemic transport/clearance rates.
    transport.k_mps = 0.080;
    transport.k_np_loss = 0.006;
    transport.k_h_in = 0.006;
    transport.k_h_out = 0.010;
    transport.k_h_loss = 0.005;
    transport.k_p_in = 0.010;
    transport.k_p_out = 0.004;
    transport.k_p_loss = 0.004;
    transport.k_capcore = 0.012;
    transport.k_core_back = 0.002;
    transport.k_core_loss = 0.003;
    transport.k_d_h_in = 0.008;
    transport.k_d_h_out = 0.006;
    transport.k_d_p_in = 0.006;
    transport.k_d_p_out = 0.003;
    transport.k_d_capcore = 0.015;
    transport.k_d_corecap = 0.004;
    transport.k_elim_b = 0.120;
    transport.k_elim_h = 0.050;
    transport.k_elim_p = 0.035;
    transport.k_elim_core = 0.025;
    transport.k_elim_mps = 0.060;
end

function activation = ph_activation(pH, pH50)
% Return dimensionless acid activation using a base-10 logistic relationship.
    hill_pH = 2.5;
    activation = 1 ./ (1 + 10.^(hill_pH.*(pH-pH50)));
end

function activation = ros_activation(ros_mM, K_ros_mM)
% Return dimensionless ROS activation using a Hill saturation relationship.
    hill_ros = 1.3;
    activation = ros_mM.^hill_ros ./ ...
        (K_ros_mM.^hill_ros + ros_mM.^hill_ros + eps);
end

function rate = local_release_rate(pH, ros_mM, design, mechanism)
% Calculate a dimensionally consistent first-order release rate in h^-1.
    k_leak = design(1);
    k_pH = design(2);
    pH50 = design(3);
    k_ROS = design(4);
    K_ROS = design(5);
    k_interaction = design(6);

    f_pH = ph_activation(pH,pH50);
    f_ROS = ros_activation(ros_mM,K_ROS);

    switch mechanism
        case 'baseline'
            rate = k_leak;
        case 'pH'
            rate = k_leak + k_pH*f_pH;
        case 'ROS'
            rate = k_leak + k_ROS*f_ROS;
        case 'dual_additive'
            rate = k_leak + k_pH*f_pH + k_ROS*f_ROS;
        case 'dual_interaction'
            rate = k_leak + k_pH*f_pH + k_ROS*f_ROS + ...
                k_interaction*f_pH*f_ROS;
        otherwise
            error('Unknown mechanism: %s',mechanism);
    end
end

function A = build_system_matrix(design, mechanism, scenario, transport)
% Construct the 15-state linear ODE matrix for transport, release, and AUC.
% State order:
% 1-5 bound NP: blood, MPS, healthy wall, plaque cap, plaque core.
% 6-10 free drug: blood, MPS, healthy wall, plaque cap, plaque core.
% 11-14 cumulative AUC: blood, MPS, healthy wall, total plaque.
% 15 cumulative irreversible loss/elimination sink for mass-balance checks.

    tr = transport;
    tr.k_p_in = scenario.k_plaque_in;
    tr.k_capcore = scenario.k_cap_core;

    k_blood = local_release_rate(7.4,0.005,design,mechanism);
    k_mps_release = local_release_rate(7.2,0.020,design,mechanism);
    k_healthy = local_release_rate(7.4,0.005,design,mechanism);
    k_cap = local_release_rate(scenario.cap_pH,scenario.cap_ROS_mM,design,mechanism);
    k_core = local_release_rate(scenario.core_pH,scenario.core_ROS_mM,design,mechanism);

    A = zeros(15,15);
    Nb=1; Nm=2; Nh=3; Nc=4; Ncore=5;
    Db=6; Dm=7; Dh=8; Dc=9; Dcore=10;
    AUCb=11; AUCm=12; AUCh=13; AUCp=14; Cleared=15;

    A(Nb,Nb) = -(tr.k_mps+tr.k_h_in+tr.k_p_in+tr.k_np_loss+k_blood);
    A(Nb,Nh) = tr.k_h_out;
    A(Nb,Nc) = tr.k_p_out;

    A(Nm,Nb) = tr.k_mps;
    A(Nm,Nm) = -(tr.k_np_loss+k_mps_release);

    A(Nh,Nb) = tr.k_h_in;
    A(Nh,Nh) = -(tr.k_h_out+tr.k_h_loss+k_healthy);

    A(Nc,Nb) = tr.k_p_in;
    A(Nc,Ncore) = tr.k_core_back;
    A(Nc,Nc) = -(tr.k_p_out+tr.k_capcore+tr.k_p_loss+k_cap);

    A(Ncore,Nc) = tr.k_capcore;
    A(Ncore,Ncore) = -(tr.k_core_back+tr.k_core_loss+k_core);

    A(Db,Nb) = k_blood;
    A(Db,Db) = -(tr.k_elim_b+tr.k_d_h_in+tr.k_d_p_in);
    A(Db,Dh) = tr.k_d_h_out;
    A(Db,Dc) = tr.k_d_p_out;

    A(Dm,Nm) = k_mps_release;
    A(Dm,Dm) = -tr.k_elim_mps;

    A(Dh,Nh) = k_healthy;
    A(Dh,Db) = tr.k_d_h_in;
    A(Dh,Dh) = -(tr.k_elim_h+tr.k_d_h_out);

    A(Dc,Nc) = k_cap;
    A(Dc,Db) = tr.k_d_p_in;
    A(Dc,Dcore) = tr.k_d_corecap;
    A(Dc,Dc) = -(tr.k_elim_p+tr.k_d_p_out+tr.k_d_capcore);

    A(Dcore,Ncore) = k_core;
    A(Dcore,Dc) = tr.k_d_capcore;
    A(Dcore,Dcore) = -(tr.k_elim_core+tr.k_d_corecap);

    A(AUCb,Db) = 1;
    A(AUCm,Dm) = 1;
    A(AUCh,Dh) = 1;
    A(AUCp,Dc) = 1;
    A(AUCp,Dcore) = 1;

    % Accumulate every irreversible carrier-loss and free-drug elimination
    % pathway in one sink state. This state does not feed back into exposure.
    A(Cleared,Nb) = tr.k_np_loss;
    A(Cleared,Nm) = tr.k_np_loss;
    A(Cleared,Nh) = tr.k_h_loss;
    A(Cleared,Nc) = tr.k_p_loss;
    A(Cleared,Ncore) = tr.k_core_loss;
    A(Cleared,Db) = tr.k_elim_b;
    A(Cleared,Dm) = tr.k_elim_mps;
    A(Cleared,Dh) = tr.k_elim_h;
    A(Cleared,Dc) = tr.k_elim_p;
    A(Cleared,Dcore) = tr.k_elim_core;
end

function result = simulate_endpoint(design, mechanism, scenario, transport, time_h, dose)
% Evaluate the exact endpoint of the linear compartment model with expm.
    A = build_system_matrix(design, mechanism, scenario, transport);
    initial_state = zeros(15,1);
    initial_state(1) = dose;
    final_state = expm(A*time_h)*initial_state;

    result.blood_auc = final_state(11);
    result.mps_auc = final_state(12);
    result.healthy_auc = final_state(13);
    result.plaque_auc = final_state(14);
    result.off_target_auc = result.blood_auc + result.mps_auc + result.healthy_auc;
    result.exposure_selectivity_ratio = result.plaque_auc / max(result.healthy_auc,eps);
    result.exposure_efficiency = result.plaque_auc / ...
        max(result.plaque_auc+result.off_target_auc,eps);
end

function sequence = halton_block(n, dimensions, start_index, bases)
% Generate a deterministic low-discrepancy Halton block without a toolbox.
    if nargin < 4
        bases = first_primes(dimensions);
    end
    sequence = zeros(n,dimensions);
    for j = 1:dimensions
        sequence(:,j) = van_der_corput(n,bases(j),start_index);
    end
end

function values = van_der_corput(n, base, start_index)
% Generate one radical-inverse sequence used as a Halton dimension.
    values = zeros(n,1);
    for row = 1:n
        integer = row-1+start_index;
        fraction = 1;
        radical = 0;
        while integer > 0
            fraction = fraction/base;
            radical = radical + fraction*mod(integer,base);
            integer = floor(integer/base);
        end
        values(row) = radical;
    end
end

function primes_out = first_primes(n)
% Return the first n prime numbers using trial division.
    primes_out = zeros(1,n);
    candidate = 2;
    count = 0;
    while count < n
        is_prime = true;
        for j = 1:count
            p = primes_out(j);
            if p*p > candidate
                break;
            end
            if mod(candidate,p) == 0
                is_prime = false;
                break;
            end
        end
        if is_prime
            count = count+1;
            primes_out(count) = candidate;
        end
        candidate = candidate+1;
    end
end

function [pareto_indices, selected_index] = pareto_knee(plaque_auc, off_target_auc)
% Find nondominated points and select the point nearest the normalized ideal.
    n = numel(plaque_auc);
    is_pareto = true(n,1);
    for i = 1:n
        dominates_i = plaque_auc >= plaque_auc(i) & off_target_auc <= off_target_auc(i) & ...
            (plaque_auc > plaque_auc(i) | off_target_auc < off_target_auc(i));
        if any(dominates_i)
            is_pareto(i) = false;
        end
    end
    pareto_indices = find(is_pareto);
    p = plaque_auc(pareto_indices);
    o = off_target_auc(pareto_indices);
    p_norm = (p-min(p)) ./ max(max(p)-min(p),eps);
    o_norm = (max(o)-o) ./ max(max(o)-min(o),eps);
    distance_to_ideal = sqrt((1-p_norm).^2+(1-o_norm).^2);
    [~,local_index] = min(distance_to_ideal);
    selected_index = pareto_indices(local_index);
end

function multiplier = lognormal_multiplier(z, coefficient_of_variation)
% Convert a standard-normal deviate to a mean-one lognormal multiplier.
    sigma = sqrt(log(1+coefficient_of_variation^2));
    multiplier = exp(-0.5*sigma^2 + sigma*z);
end

function clipped = clip_value(value, lower, upper)
% Restrict a scalar value to a closed interval.
    clipped = min(max(value,lower),upper);
end

function clipped = clip_vector(values, lower, upper)
% Restrict each vector component to its corresponding closed interval.
    clipped = min(max(values,lower),upper);
end

function percentile = empirical_percentile(values, probability_percent)
% Calculate a linearly interpolated percentile without prctile.
    sorted_values = sort(values(:));
    n = numel(sorted_values);
    position = 1 + (n-1)*(probability_percent/100);
    lower_index = floor(position);
    upper_index = ceil(position);
    if lower_index == upper_index
        percentile = sorted_values(lower_index);
    else
        weight = position-lower_index;
        percentile = sorted_values(lower_index)*(1-weight) + sorted_values(upper_index)*weight;
    end
end

function output = evaluate_sobol_row(row, selected_dual, scenario, transport, settings)
% Map one Sobol row to design/transport/scenario values and return SER.
    design = selected_dual;
    design(1:6) = row(1:6);
    sampled_transport = transport;
    sampled_transport.k_mps = row(7);
    sampled_scenario = scenario;
    sampled_scenario.k_plaque_in = row(8);
    sampled_scenario.cap_pH = row(9);
    sampled_scenario.core_ROS_mM = row(10);

    responsive = simulate_endpoint(design,'dual_interaction',sampled_scenario, ...
        sampled_transport,settings.analysis_time_h,settings.initial_normalized_dose);
    baseline = simulate_endpoint(design,'baseline',sampled_scenario, ...
        sampled_transport,settings.analysis_time_h,settings.initial_normalized_dose);
    output = responsive.exposure_selectivity_ratio / ...
        max(baseline.exposure_selectivity_ratio,eps);
end
